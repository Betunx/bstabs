{
  "name": "bstabs-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "start": "pnpm --filter black-sheep-app start",
    "build": "pnpm --filter black-sheep-app build",
    "deploy": "pnpm --filter black-sheep-app run deploy",
    "api:dev": "pnpm --filter blacksheep-api-workers dev",
    "api:deploy": "pnpm --filter blacksheep-api-workers run deploy",
    "test": "pnpm run test:be && pnpm run test:fe",
    "test:fe": "pnpm --filter black-sheep-app test:ci",
    "test:be": "pnpm --filter blacksheep-api-workers test",
    "lint": "pnpm -r --if-present lint",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "lint-staged": {
    "*.{ts,html,json,md,scss,css,mjs,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.1"
  }
}
